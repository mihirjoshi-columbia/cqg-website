# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses Row Level Security. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Columbia Quant Group <noreply@yourdomain.org>"

# Base URL used to build links inside emails (verification, password reset, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required to trigger /api/blasts/dispatch (scheduled email blast
# sending). Must be named exactly CRON_SECRET: on Vercel, setting this project env
# var makes Vercel Cron auto-attach it as "Authorization: Bearer <value>" on every
# cron-triggered request (see vercel.json) -- no need to put the secret anywhere in
# the repo. If not deploying to Vercel, point any scheduler (e.g. cron-job.org) at
# GET /api/blasts/dispatch?secret=<value> on an interval (every 5-10 min is plenty).
CRON_SECRET=
