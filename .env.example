# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses Row Level Security. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email). BOTH are required in production -- there is no
# fallback From address any more, and a missing key now fails loudly instead of
# silently dropping verification emails.
#
# RESEND_FROM_EMAIL must be on a domain verified in the Resend dashboard.
# Until a domain is verified, Resend only accepts sends to the account owner's
# own address and rejects everything else with a 403 -- which is what blocks
# verification emails to student addresses.
#
# To check what Resend is actually returning in a deployed environment:
#   curl "$SITE_URL/api/email/health?secret=$CRON_SECRET&to=you@example.com"
RESEND_API_KEY=
RESEND_FROM_EMAIL="Columbia Quant Group <noreply@yourdomain.org>"

# Optional but recommended for deliverability. A monitored Reply-To reads as
# more legitimate than a bare noreply@ on a domain with no MX record, which is
# one of the signals that pushes mail to Junk even when it is accepted.
RESEND_REPLY_TO=

# Optional. Adds List-Unsubscribe to BLAST mail only (never to verification or
# password-reset mail, which a user must not be able to opt out of). Bulk
# senders without it get filtered harder.
RESEND_UNSUBSCRIBE_MAILTO=

# Base URL used to build links inside emails (verification, password reset, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required to trigger /api/blasts/dispatch (scheduled email blast
# sending). Vercel's own Cron needs a Pro plan for anything more frequent than
# once/day, so dispatch is instead triggered every 5 min by the GitHub Actions
# workflow at .github/workflows/dispatch-blasts.yml, which calls this endpoint
# with "Authorization: Bearer <CRON_SECRET>". Set the SAME value in two places:
#   1. This env var, on whatever host runs the app (e.g. Vercel project settings)
#   2. A GitHub Actions repo secret also named CRON_SECRET (Settings -> Secrets
#      and variables -> Actions), plus a SITE_URL secret set to the deployed
#      origin (e.g. https://columbiaquantgroup.com, no trailing slash)
CRON_SECRET=
